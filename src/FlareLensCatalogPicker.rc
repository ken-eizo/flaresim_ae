#include <windows.h>
#ifndef IDC_STATIC
#define IDC_STATIC (-1)
#endif
16001 DIALOGEX 0, 0, 475, 330
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "FlareSimAE | Original Nuke Lens Catalog"
FONT 9, "Segoe UI"
BEGIN
